@article{b_f_electric14,
ISSN = {00029890, 19300972},
URL = {http://www.jstor.org/stable/10.4169/amer.math.monthly.123.7.657},
abstract = {We give an analogy between nonreversible Markov chains and electric networks much in the flavor of the classical reversible results originating from Kakutani and later Kem{\'e}ny-Snell-Knapp and Kelly. Nonreversibility is made possible by a voltage multiplier-a new electronic component. We prove that absorption probabilities, escape probabilities, expected number of jumps over edges, and commute times can be computed from electrical properties of the network as in the classical case. The central quantity is still the effective resistance, which we do have in our networks despite the fact that individual parts cannot be replaced by a simple resistor. We rewrite a recent nonreversible result of Gaudilli{\`e}re-Landim about the Dirichlet and Thomson principles into the electrical language. We also give a few tools that can help in reducing and solving the network. The subtlety of our network is, however, that the classical Rayleigh monotonicity is lost.},
author = {M. Bal{\'a}zs, {\'A}. Folly},
journal = {The American Mathematical Monthly},
number = {7},
pages = {657-682},
publisher = {Mathematical Association of America},
title = {An Electric Network for Nonreversible Markov Chains},
volume = {123},
year = {2016}
}

