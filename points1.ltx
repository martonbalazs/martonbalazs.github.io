%Defining the minimum points needed for grades. Can change it anytime (e.g. after curving).

\newcounter{ga}\setcounter{ga}{365}               %Minimum for A
\newcounter{gab}\setcounter{gab}{350}             %Minimum for AB
\newcounter{gb}\setcounter{gb}{320}               %Minimum for B
\newcounter{gbc}\setcounter{gbc}{305}             %Minimum for BC
\newcounter{gc}\setcounter{gc}{270}               %Minimum for C
\newcounter{gd}\setcounter{gd}{230}               %Minimum for D

%Defining the maximum points which can be earned for homeworks and exams.

\newcounter{hwa}\setcounter{hwa}{10}              %Max. points for homework 1
\newcounter{hwb}\setcounter{hwb}{10}              %Max. points for homework 2
\newcounter{hwc}\setcounter{hwc}{10}              %Max. points for homework 3
\newcounter{hwd}\setcounter{hwd}{10}              %Max. points for homework 4
\newcounter{hwe}\setcounter{hwe}{10}              %Max. points for homework 5
\newcounter{hwf}\setcounter{hwf}{10}              %Max. points for homework 6
\newcounter{hwg}\setcounter{hwg}{10}              %Max. points for homework 7
\newcounter{hwh}\setcounter{hwh}{10}              %Max. points for homework 8
\newcounter{hwi}\setcounter{hwi}{10}              %Max. points for homework 9
\newcounter{hwj}\setcounter{hwj}{10}              %Max. points for homework 10
\newcounter{hwk}\setcounter{hwk}{10}              %Max. points for homework 11
\newcounter{exa}\setcounter{exa}{80}              %Max. points for midterm 1
\newcounter{exb}\setcounter{exb}{80}              %Max. points for midterm 2
\newcounter{fex}\setcounter{fex}{140}             %Max. points for the final

