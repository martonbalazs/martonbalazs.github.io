% https://tex.stackexchange.com/questions/225599/contour-integrals-of-different-kind
% Needs amssymb tikz
\newcommand\MyDupCont{%
 \tikz[overlay]
 {
  \draw[->](0.3,-0.1)arc(0:180:0.3);
  \draw[->](-0.3,-0.1)--(0.3,-0.1);
 }
}

\newcommand\MyCupCont{%
 \tikz[overlay]
 {
  \draw[->](0.3,-0.1)arc(0:180:0.3);
 }
}

\newcommand\MyDdnCont{%
 \tikz[overlay]
 {
  \draw[->](0.3,0.1)arc(180:0:-0.3);
  \draw[->](-0.3,0.1)--(0.3,0.1);
 }
}

\newcommand\MyCdnCont{%
 \tikz[overlay]
 {
  \draw[->](0.3,0.1)arc(180:0:-0.3);
 }
}

\def\IntKern{}
\newcommand\MySymbolint[2][0pt]{%
 \mathchoice
 {\def\IntKern{\dimexpr-.6\wd0+#1\relax}\Symbolint\displaystyle\displaystyle{\scalebox{.8}{$#2$}}}%
 {\def\IntKern{\dimexpr-.62\wd0+#1\relax}\Symbolint\textstyle\textstyle{\scalebox{.6}{$#2$}}}%
 {\def\IntKern{\dimexpr-.642\wd0+#1\relax}\Symbolint\scriptstyle\scriptscriptstyle{\scalebox{.45}{$#2$}}}%
 {\def\IntKern{\dimexpr-.67\wd0+#1\relax}\Symbolint\scriptscriptstyle\scriptscriptstyle{\scalebox{.35}{$#2$}}}%
 \!\int}
\newcommand\Symbolint[3]{%
 {\setbox0=\hbox{$#1{#2#3}{\int}$ }%
 \vcenter{\hbox{\ \ $#2#3$ }}\kern\IntKern}
}

\def\dupint{\MySymbolint\MyDupCont}
\def\cupint{\MySymbolint\MyCupCont}
\def\ddnint{\MySymbolint\MyDdnCont}
\def\cdnint{\MySymbolint\MyCdnCont}
